%%{init: {'theme': 'neutral'}}%%
graph TD
    submit(["Operator submits mission YAML<br/>POST /missions"])

    subgraph registration["Registration (synchronous, one lock)"]
        validate_placement["validate_placement()<br/>CPU/memory/GPU-profile vs total host capacity"]
        register["register_deployment()<br/>atomic: resolve MAC prefix + reserve GPU devices<br/>against every OTHER active deployment"]
    end

    resp202(["202 Accepted<br/>{mission_id, mac_prefix}"])
    resp422(["422<br/>malformed or infeasible"])
    resp409(["409<br/>well-formed but no free<br/>MAC prefix / GPU slice right now"])

    subgraph deploy_bg["deploy_mission() -- background task"]
        step1["1. Networks<br/>OVN switches + router (per mission_id)"]
        step2["2. Storage<br/>clone/copy golden image per VM"]
        step3["3. Define VMs<br/>render XML, attach OVN port + GPU, start"]
        step4["4. Validate<br/>re-inspect live XML vs spec"]
    end

    running(["state: Running"])
    err(["state: Error<br/>logged + step recorded"])
    rollback["automatic rollback<br/>tear down whatever step 1-3 created"]
    rolledback(["state: RolledBack<br/>MAC prefix + GPU freed"])

    teardown_req(["Operator: DELETE /missions/id"])
    teardown_bg["teardown_mission()<br/>VMs -> networking -> storage"]
    destroyed(["state: Destroyed<br/>MAC prefix + GPU freed"])

    submit --> validate_placement
    validate_placement -->|"fits"| register
    validate_placement -->|"doesn't fit"| resp422
    register -->|"ok"| resp202
    register -->|"ValueError"| resp422
    register -->|"RuntimeError: contention"| resp409
    resp202 --> step1 --> step2 --> step3 --> step4
    step4 -->|"pass"| running
    step1 -.->|"any step fails"| err
    step2 -.->|"any step fails"| err
    step3 -.->|"any step fails"| err
    step4 -->|"fail"| err
    err --> rollback
    rollback -->|"success"| rolledback
    rollback -->|"rollback itself fails"| err
    running --> teardown_req --> teardown_bg --> destroyed

    classDef sync fill:#EEEDFE,stroke:#534AB7,color:#26215C
    classDef bg fill:#E1F5EE,stroke:#0F6E56,color:#04342C
    classDef good fill:#EAF3DE,stroke:#3B6D11,color:#173404
    classDef bad fill:#FCEBEB,stroke:#A32D2D,color:#501313
    classDef neutral fill:#F1EFE8,stroke:#5F5E5A,color:#2C2C2A
    class validate_placement,register sync
    class step1,step2,step3,step4,teardown_bg,rollback bg
    class running,resp202,rolledback,destroyed good
    class err,resp422,resp409 bad
    class submit,teardown_req neutral
